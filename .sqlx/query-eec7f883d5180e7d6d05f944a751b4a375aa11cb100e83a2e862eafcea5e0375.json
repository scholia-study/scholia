    "query": "SELECT DISTINCT u.id, u.display_name, u.handle\n           FROM users u\n           JOIN user_roles ur ON ur.user_id = u.id\n           JOIN roles r ON r.id = ur.role_id\n           WHERE r.name IN ('admin', 'editor')\n           ORDER BY u.display_name",
