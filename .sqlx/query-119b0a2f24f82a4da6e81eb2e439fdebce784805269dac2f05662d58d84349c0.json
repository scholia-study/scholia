    "query": "SELECT m.id, m.sender_id,\n               u.display_name AS \"sender_display_name?\",\n               u.handle AS \"sender_handle?\",\n               m.body, m.created_at\n           FROM article_review_messages m\n           LEFT JOIN users u ON u.id = m.sender_id\n           WHERE m.article_id = $1\n           ORDER BY m.created_at",
